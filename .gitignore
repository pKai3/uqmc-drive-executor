# Private runtime data and projections must never enter source control.
/private/
/sync/
/inventories/
/evidence/
/journals/
/backups/
/receipts/
/reports/
/exports/
/artifacts/
/test-artifacts/
/test-results/
*.jsonl
*.sqlite*
*.db
*.log

# Offline deduplication runtime inputs and reports, wherever they are written.
*.dedup-inventory.json
*.dedup-hashes.json
*.dedup-ignore.json
*.dedup-report.json
*.dedup-report.csv

# Credentials and local configuration.
/secrets/
.env
.env.*
credentials*
*credentials*.json
*token*.json
*.pem
*.key
config.local.*

# Python, editors and OS output.
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
.venv-*/
venv/
*.egg-info/
build/
dist/
.DS_Store
.idea/
.vscode/
*.swp
